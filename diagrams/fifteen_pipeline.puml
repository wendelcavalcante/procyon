@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial

skinparam rectangle {
  BorderColor #444444
  FontColor #222222
  RoundCorner 12
}

title Fifteen Puzzle Generation Pipeline Example

package "Generation Pipeline" #FADBD8 {
  rectangle "GenerateCandidatesStage\nFisherYatesFifteenGenerator\ncandidate_count=100" as Gen #FDEDEC
  rectangle "ValidateCandidatesStage\nFifteenSolvabilityValidator" as Validate #FDEDEC
  rectangle "AssessDifficultyStage\nFifteenManhattanDifficultyAssessor" as Assess #FDEDEC
  rectangle "SelectClosestDifficultyCandidateStage" as Select #FDEDEC
}

rectangle "AdaptationRequest\n(target difficulty)" as Request #D5F5E3
rectangle "GenerationResult\n(selected level + candidates)" as Result #D6EAF8

Request --> Gen
Gen --> Validate
Validate --> Assess
Assess --> Select
Select --> Result

@enduml