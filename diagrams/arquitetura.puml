@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle

title Adaptive Game Level Design Architecture - Macro Component Diagram

package "Game Environment<T>" {
  [Game Runtime] as Runtime
  [Player or Simulated Player] as Player
}

package "Telemetry and Modeling<T>" {
  [Telemetry Collector] as Telemetry
  [Player Model] as PlayerModel
}

package "Adaptation Core<T>" {
  [Design Goals Manager] as Goals
  [Adaptation Engine] as Engine
  [Adaptive Dimension Manager] as Dimensions
}

package "Adaptive Design Dimensions" {
  [Difficulty] as Difficulty
  [Gameplay] as Gameplay
  [Layout] as Layout
  [Assets] as Assets
  [Soundtrack] as Soundtrack
  [Narrative] as Narrative
}

package "Content Generation<T>" {
  [Generation Strategy Registry] as Registry
  [Content Generator] as Generator
}

package "Validation and Integration<T>" {
  [Validation Engine] as Validation
  [Adapted Level Design] as LevelDesign
  [Runtime Integration Adapter] as Adapter
}

Player --> Runtime
Runtime --> Telemetry
Telemetry --> PlayerModel
PlayerModel --> Engine
Goals --> Engine
Engine --> Dimensions

Dimensions --> Difficulty
Dimensions --> Gameplay
Dimensions --> Layout
Dimensions --> Assets
Dimensions --> Soundtrack
Dimensions --> Narrative

Difficulty --> Registry
Gameplay --> Registry
Layout --> Registry
Assets --> Registry
Soundtrack --> Registry
Narrative --> Registry

Registry --> Generator
Generator --> Validation
Validation --> LevelDesign
LevelDesign --> Adapter
Adapter --> Runtime

note bottom of Difficulty
Initial prototype:
puzzle difficulty adaptation
end note

@enduml